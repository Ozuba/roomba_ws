# rclgd: keep the GDExtension descriptor (needed by Godot to load rclgd),
# ignore any build artifacts placed next to it
!src/*/addons/rclgd/bin/
src/*/addons/rclgd/bin/*
!src/*/addons/rclgd/bin/rclgd.gdextension
!src/*/addons/rclgd/bin/rclgd.gdextension.uid
